'temperature'].values * units.degC\ndewpoint = sounding_data['dewpoint'].values * units.degC\nwind_speed = sounding_data['speed'].values * units.knots\nwind_dir = sounding_data['direction'].values * units.degrees\nu = sounding_data['u_wind'].values * units.knots\nv = sounding_data['v_wind'].values * units.knots","key":"zjdRhEqxq7"},{"type":"outputs","id":"t1rCMdMzuMVLsWyIJvhHU","children":[],"key":"DAatbAHE8W"}],"key":"XWRMHXz5RD"},{"type":"block","kind":"notebook-content","data":{"tags":[]},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create Sounding Plot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iQRMZ9cZzO"}],"identifier":"create-sounding-plot","label":"Create Sounding Plot","html_id":"create-sounding-plot","implicit":true,"key":"owBcjw9M6n"}],"visibility":"show","key":"ZaZTtrfiqu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create figure and set size\nfig = plt.figure(figsize=(9, 9))\nskew = SkewT(fig, rotation=45)\n\n# Plot temperature and dewpoint lines\nskew.plot(pres, temp, 'red')\nskew.plot(pres, dewpoint, 'green')\n\n# Plot wind barbs\nmy_interval = np.arange(100, 1000, 25) * units('hPa')\nix = mpcalc.resample_nn_1d(pres, my_interval)\nskew.plot_barbs(pres[ix], u[ix], v[ix], y_clip_radius=0.001)\n\n# Improve labels and set axis limits\nskew.ax.set_xlabel('Temperature (\\N{DEGREE CELSIUS})')\nskew.ax.set_ylabel('Pressure (hPa)')\nskew.ax.set_ylim(1000, 100)\n\n# Add the relevant special lines\nskew.plot_dry_adiabats(t0=np.arange(233, 533, 10) * units.K, alpha=0.25, color='orangered')\nskew.plot_moist_adiabats(t0=np.arange(233, 400, 5) * units.K, alpha=0.25, color='tab:green')\nskew.plot_mixing_lines(pressure=np.arange(1000, 99, -25) * units.hPa, linestyle='dotted', color='tab:blue')\n\n# Add the MetPy logo!\nfig = plt.gcf()\nadd_metpy_logo(fig, 115, 100, 